name: Test GitHub App Access

on:
  workflow_dispatch:

jobs:
  test-app-token:
    runs-on: ubuntu-latest
    steps:
    - name: Generate token with GitHub App
      id: app_token
      uses: tibdex/github-app-token@v2
      with:
        app_id: ${{ secrets.APP_ID }}
        private_key: ${{ secrets.APP_PRIVATE_KEY }}
    
    - name: Test token access
      env:
        GITHUB_TOKEN: ${{ steps.app_token.outputs.token }}
      run: |
        echo "🔑 Testando GitHub App token..."
        
        # Testar acesso aos repositórios de submódulos
        repos=(
          "KAVOO-DEV/kavoo-intra-monolith"
          "KAVOO-DEV/kavoo-front"
          "KAVOO-DEV/kavoo-admins"
          "KAVOO-DEV/kavoo-checkouts" 
          "KAVOO-DEV/kavoo-members"
          "KAVOO-DEV/kavoo-users"
          "KAVOO-DEV/kavoo-webhooks"
        )
        
        echo "📊 Testando acesso aos repositórios:"
        for repo in "${repos[@]}"; do
          echo "Testando acesso ao $repo..."
          if curl -s -H "Authorization: token $GITHUB_TOKEN" \
                  -H "Accept: application/vnd.github.v3+json" \
                  "https://api.github.com/repos/$repo" | grep -q '"name"'; then
            echo "✅ Acesso OK: $repo"
          else
            echo "❌ Sem acesso: $repo"
          fi
        done
        
        echo ""
        echo "🔍 Listando repositórios acessíveis pela app:"
        curl -s -H "Authorization: token $GITHUB_TOKEN" \
             "https://api.github.com/installation/repositories" | \
             jq -r '.repositories[] | "✅ \(.full_name)"' || echo "Erro ao listar repositórios"

    - name: Checkout with GitHub App token
      uses: actions/checkout@v4
      with:
        submodules: recursive
        token: ${{ steps.app_token.outputs.token }}
        fetch-depth: 0
        
    - name: Verify submodules downloaded
      run: |
        echo "📋 Status dos submódulos após checkout:"
        git submodule status
        
        echo ""
        echo "📁 Verificando estrutura de arquivos importantes:"
        find apps -type f \( -name "Dockerfile" -o -name "package.json" -o -name "main.py" -o -name "requirements.txt" \) | sort
        
        echo ""
        echo "📊 Resumo detalhado por app:"
        for app in apps/*/; do
          if [ -d "$app" ]; then
            app_name=$(basename "$app")
            file_count=$(find "$app" -type f 2>/dev/null | wc -l)
            
            if [ "$file_count" -gt 0 ]; then
              echo "✅ $app_name ($file_count arquivos)"
              
              # Verificar arquivos específicos importantes
              if [ -f "$app/Dockerfile" ]; then
                echo "  🐳 Dockerfile: ✅"
              else
                echo "  🐳 Dockerfile: ❌"
              fi
              
              if [ -f "$app/package.json" ]; then
                echo "  📦 package.json: ✅"
              elif [ -f "$app/requirements.txt" ]; then
                echo "  🐍 requirements.txt: ✅"
              else
                echo "  📦 dependencies: ❓"
              fi
              
              if [ -f "$app/main.py" ]; then
                echo "  🚀 main.py: ✅"
              elif [ -f "$app/next.config.mjs" ]; then
                echo "  🚀 Next.js config: ✅"
              else
                echo "  🚀 entry point: ❓"
              fi
            else
              echo "❌ $app_name (vazio)"
            fi
            echo ""
          fi
        done
        
        echo ""
        echo "🎯 Verificação final:"
        all_good=true
        expected_apps=("front" "admins" "checkout" "members" "users" "webhooks")
        
        for app_name in "${expected_apps[@]}"; do
          if [ -f "apps/$app_name/Dockerfile" ]; then
            echo "✅ apps/$app_name/Dockerfile existe"
          else
            echo "❌ apps/$app_name/Dockerfile NÃO encontrado"
            all_good=false
          fi
        done
        
        if $all_good; then
          echo ""
          echo "🚀 SUCESSO! Todos os submódulos foram baixados corretamente!"
          echo "🎉 GitHub App está funcionando perfeitamente!"
        else
          echo ""
          echo "⚠️ Alguns submódulos ainda não foram baixados ou estão incompletos"
          echo "🔧 Verifique as configurações da GitHub App e permissões"
          exit 1
        fi